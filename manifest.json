{
  "manifest_version": 3,
  "name": "NoSlop - AI Video Blocker for YouTube",
  "version": "5.0.0",
  "description": "Detect low-effort AI content on YouTube with local statistical scoring and optional model training data.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.ytimg.com/*",
    "*://*.ggpht.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/engines/textNormalization.js",
        "content/engines/semanticEngine.js",
        "content/engines/communityEngine.js",
        "content/engines/scoringEngine.js",
        "content/engines/thumbnailEngine.js",
        "content/engines/audioScriptEngine.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
